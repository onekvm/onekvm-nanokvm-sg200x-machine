#!/bin/sh
set -eu

slot=
boot_build_id=

for argument in $(cat /proc/cmdline); do
    case "$argument" in
        rauc.slot=A|rauc.slot=B) slot=${argument#rauc.slot=} ;;
        onekvm.build-id=*) boot_build_id=${argument#onekvm.build-id=} ;;
    esac
done

[ -n "$slot" ] || { echo "missing rauc.slot" >&2; exit 1; }
[ -n "$boot_build_id" ] || { echo "missing boot build ID" >&2; exit 1; }

root_build_id=$(cat /usr/share/onekvm/build-id)
[ "$boot_build_id" = "$root_build_id" ] || {
    echo "boot/rootfs build ID mismatch" >&2
    exit 1
}

kernel_release=$(uname -r)
module_build_id=$(cat "/lib/modules/$kernel_release/onekvm-build-id")
[ "$module_build_id" = "$root_build_id" ] || {
    echo "kernel/modules build ID mismatch" >&2
    exit 1
}

mountpoint -q /boot
if grep -q " / overlay rw[, ]" /proc/mounts; then
    grep -q " /rofs squashfs ro[, ]" /proc/mounts
else
    mountpoint -q /data
    grep -q " / squashfs ro[, ]" /proc/mounts
fi

# onekvm.service Type=notify already waited for Core. Do not launch
# onekvm-cli (a cold Go binary) in a loop on the single-core boot path.
attempt=0
while [ "$attempt" -lt 50 ]; do
    if systemctl is-active --quiet onekvm.service; then
        rauc status mark-good

        cache_dir=/run/onekvm
        cache=$cache_dir/rauc-status.json
        temporary=$cache.tmp.$$
        mkdir -p "$cache_dir"
        chmod 0755 "$cache_dir"
        if rauc status --detailed --output-format=json >"$temporary"; then
            chmod 0644 "$temporary"
            mv -f "$temporary" "$cache"
            systemctl stop rauc.service || true
        else
            rm -f "$temporary"
            echo "unable to cache RAUC status; keeping the service available" >&2
        fi
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 0.1
done

echo "OneKVM service was not active for slot health" >&2
exit 1
