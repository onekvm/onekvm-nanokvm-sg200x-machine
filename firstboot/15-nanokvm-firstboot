#!/bin/sh

# Shared NanoKVM / Pro first-boot A/B storage initialization.

nanokvm_enabled() {
    return 0
}

nanokvm_die() {
    nanokvm_oled_error
    # The record is best-effort. A save failure must still reach fatal.
    nanokvm_save_boot_error "$1" || true
    if [ "${nanokvm_boot_error_saved:-false}" = true ]; then
        nanokvm_splash --message "OneKVM NanoKVM storage migration: $1" error-saved
    else
        nanokvm_splash --message "OneKVM NanoKVM storage migration: $1" error
    fi
    fatal "OneKVM NanoKVM storage migration: $1"
}

# Userdata creation failures usually come from a failing card.
nanokvm_die_userdata() {
    nanokvm_die "$1. The storage medium may be unreliable."
}

nanokvm_splash() {
    if [ "${1:-}" = install ] && [ -n "${2:-}" ]; then
        nanokvm_oled_step=$2
        nanokvm_oled_state install "$2"
    fi
    command -v onekvm-boot-splash >/dev/null 2>&1 || return 0
    onekvm-boot-splash --language "${splash_language:-en}" "$@" 2>/dev/null || true
}

# Leave onekvm-boot-error/try-N.zip on the boot FAT.
# If packing fails, leave onekvm-boot-error/try-N/ instead. Never both.
# Never read firstboot.txt.
nanokvm_boot_error_reason_file() {
    boot_error_record=$1
    boot_error_text=$2
    boot_error_try=$3
    boot_error_packed=$4
    {
        if [ "$boot_error_packed" = zip ]; then
            case ${splash_language:-en} in
                zh) printf '安装已暂停。原因写在下面。这次记录是 SD 卡 onekvm-boot-error/%s.zip。\n' "$boot_error_try" ;;
                zh_tw) printf '安裝已暫停。原因寫在下面。這次記錄是 SD 卡 onekvm-boot-error/%s.zip。\n' "$boot_error_try" ;;
                *) printf 'Setup paused. The reason is below. This record is onekvm-boot-error/%s.zip on the SD card.\n' "$boot_error_try" ;;
            esac
        else
            case ${splash_language:-en} in
                zh) printf '安装已暂停。原因写在下面。这次记录在 SD 卡 onekvm-boot-error/%s 文件夹。\n' "$boot_error_try" ;;
                zh_tw) printf '安裝已暫停。原因寫在下面。這次記錄在 SD 卡 onekvm-boot-error/%s 資料夾。\n' "$boot_error_try" ;;
                *) printf 'Setup paused. The reason is below. This record is the onekvm-boot-error/%s folder on the SD card.\n' "$boot_error_try" ;;
            esac
        fi
        printf '\nreason: %s\n' "$boot_error_text"
    } >"$boot_error_record/reason.txt"
}

nanokvm_write_boot_error_files() {
    boot_error_record=$1
    boot_error_text=$2
    boot_error_try=$3
    nanokvm_boot_error_reason_file "$boot_error_record" "$boot_error_text" "$boot_error_try" "$4" || return 1
    if [ -r "${ONEKVM_CMDLINE_FILE:-/proc/cmdline}" ]; then
        cat "${ONEKVM_CMDLINE_FILE:-/proc/cmdline}" >"$boot_error_record/cmdline.txt" || return 1
    else
        : >"$boot_error_record/cmdline.txt" || return 1
    fi
    {
        printf 'media: %s\nslot: %s\ndisk: %s\nloader: %s\n' \
            "${storage_media:-}" "${storage_slot:-}" "${disk:-}" "${loader:-}"
        boot_error_sysfs=${ONEKVM_STORAGE_SYSFS:-/sys/class/block}
        if [ -n "${disk_name:-}" ] && [ -d "$boot_error_sysfs/$disk_name" ]; then
            printf 'disk-size: %s\n' "$(cat "$boot_error_sysfs/$disk_name/size" 2>/dev/null || printf unknown)"
            for boot_error_part in "$boot_error_sysfs/$disk_name"p*; do
                [ -d "$boot_error_part" ] || continue
                printf 'partition: %s start=%s size=%s\n' \
                    "${boot_error_part##*/}" \
                    "$(cat "$boot_error_part/start" 2>/dev/null || printf -)" \
                    "$(cat "$boot_error_part/size" 2>/dev/null || printf -)"
            done
        fi
    } >"$boot_error_record/storage.txt" || return 1
    if [ -r /proc/self/mountinfo ]; then
        awk 'NR<=80 { print }' /proc/self/mountinfo >"$boot_error_record/mounts.txt" || return 1
    else
        : >"$boot_error_record/mounts.txt" || return 1
    fi
    if command -v dmesg >/dev/null 2>&1; then
        dmesg 2>/dev/null | tail -n 80 >"$boot_error_record/dmesg.txt" || true
    fi
    [ -f "$boot_error_record/dmesg.txt" ] || : >"$boot_error_record/dmesg.txt"
}

nanokvm_pack_boot_error() {
    boot_error_record=$1
    boot_error_zip=$2
    command -v onekvm-boot-error-zip >/dev/null 2>&1 || return 1
    boot_error_zip_tmp=$boot_error_zip.tmp
    rm -f "$boot_error_zip_tmp" || return 1
    onekvm-boot-error-zip "$boot_error_zip_tmp" \
        "$boot_error_record/reason.txt" \
        "$boot_error_record/cmdline.txt" \
        "$boot_error_record/storage.txt" \
        "$boot_error_record/mounts.txt" \
        "$boot_error_record/dmesg.txt" || {
        rm -f "$boot_error_zip_tmp"
        return 1
    }
    mv "$boot_error_zip_tmp" "$boot_error_zip" || {
        rm -f "$boot_error_zip_tmp"
        return 1
    }
}

nanokvm_write_boot_error() {
    boot_error_dest=$1
    [ -d "$boot_error_dest" ] || return 1
    boot_error_dir=$boot_error_dest/onekvm-boot-error
    mkdir -p "$boot_error_dir" || return 1
    boot_error_next=1
    for boot_error_existing in "$boot_error_dir"/try-* "$boot_error_dir"/.try-*; do
        [ -e "$boot_error_existing" ] || continue
        boot_error_base=${boot_error_existing##*/}
        boot_error_base=${boot_error_base#.}
        case "$boot_error_base" in
            try-*.zip)
                boot_error_number=${boot_error_base#try-}
                boot_error_number=${boot_error_number%.zip}
                ;;
            try-*) boot_error_number=${boot_error_base#try-} ;;
            *) continue ;;
        esac
        case "$boot_error_number" in
            ''|*[!0-9]*|0*) continue ;;
        esac
        if [ "$boot_error_number" -ge "$boot_error_next" ]; then
            boot_error_next=$((boot_error_number + 1))
        fi
    done
    boot_error_try=try-$boot_error_next
    boot_error_record=$boot_error_dir/.$boot_error_try
    rm -rf "$boot_error_record"
    mkdir "$boot_error_record" || return 1
    if ! nanokvm_write_boot_error_files "$boot_error_record" "$2" "$boot_error_try" zip; then
        rm -rf "$boot_error_record"
        return 1
    fi
    if [ -e "$boot_error_dir/$boot_error_try" ] || [ -e "$boot_error_dir/$boot_error_try.zip" ]; then
        rm -rf "$boot_error_record"
        return 1
    fi
    if nanokvm_pack_boot_error "$boot_error_record" "$boot_error_dir/$boot_error_try.zip"; then
        rm -rf "$boot_error_record"
        if [ -e "$boot_error_record" ]; then
            rm -f "$boot_error_dir/$boot_error_try.zip"
            nanokvm_boot_error_publish_folder "$boot_error_record" "$boot_error_dir/$boot_error_try" "$2" "$boot_error_try" || return 1
        else
            sync -f "$boot_error_dir/$boot_error_try.zip" 2>/dev/null || sync || return 1
        fi
    else
        nanokvm_boot_error_publish_folder "$boot_error_record" "$boot_error_dir/$boot_error_try" "$2" "$boot_error_try" || return 1
    fi
    return 0
}

nanokvm_boot_error_publish_folder() {
    boot_error_record=$1
    boot_error_final=$2
    nanokvm_boot_error_reason_file "$boot_error_record" "$3" "$4" files || return 1
    rm -f "$boot_error_final.zip" "$boot_error_final.zip.tmp" || return 1
    if [ -e "$boot_error_final" ]; then
        return 1
    fi
    mv "$boot_error_record" "$boot_error_final" || return 1
    sync -f "$boot_error_final/reason.txt" 2>/dev/null || sync || return 1
    return 0
}

nanokvm_boot_error_open() {
    boot_error_mount=
    boot_error_owned=false
    boot_error_was_ro=false
    [ -b "${loader:-}" ] || {
        printf 'OneKVM: cannot save boot error: boot partition unavailable (%s)\n' "${loader:-unidentified}" >&2
        return 1
    }
    boot_error_name=${loader##*/}
    boot_error_sysfs=${ONEKVM_STORAGE_SYSFS:-/sys/class/block}
    boot_error_dev=$(cat "$boot_error_sysfs/$boot_error_name/dev") || return 1
    boot_error_mounter=$(command -v mount) || return 1
    boot_error_mount=$(awk -v part="$boot_error_dev" '$3 == part { print $5; exit }' /proc/self/mountinfo 2>/dev/null || true)
    if [ -n "$boot_error_mount" ]; then
        boot_error_opts=$(awk -v part="$boot_error_dev" '$3 == part { print $6; exit }' /proc/self/mountinfo 2>/dev/null || true)
        case "$boot_error_opts" in
            ro|ro,*|*,ro|*,ro,*)
                "$boot_error_mounter" -o remount,rw -- "$boot_error_mount" || return 1
                boot_error_was_ro=true
                ;;
        esac
        return 0
    fi
    boot_error_mount=${migration_dir:-/run}/onekvm-boot-error-mnt
    mkdir -p "$boot_error_mount" || return 1
    if command -v timeout >/dev/null 2>&1; then
        # /init may know PATH without exporting it to timeout.
        timeout -k 2 5 "$boot_error_mounter" -t vfat -o rw,nodev,nosuid,noexec -- "$loader" "$boot_error_mount" || {
            rmdir "$boot_error_mount" 2>/dev/null || true
            boot_error_mount=
            return 1
        }
    elif ! "$boot_error_mounter" -t vfat -o rw,nodev,nosuid,noexec -- "$loader" "$boot_error_mount"; then
        rmdir "$boot_error_mount" 2>/dev/null || true
        boot_error_mount=
        return 1
    fi
    boot_error_owned=true
    return 0
}

nanokvm_boot_error_close() {
    if [ "${boot_error_owned:-false}" = true ]; then
        umount "$boot_error_mount" 2>/dev/null || true
        rmdir "$boot_error_mount" 2>/dev/null || true
    elif [ "${boot_error_was_ro:-false}" = true ]; then
        mount -o remount,ro -- "$boot_error_mount" 2>/dev/null || true
    fi
    boot_error_owned=false
    boot_error_was_ro=false
    return 0
}

nanokvm_save_boot_error() {
    nanokvm_boot_error_saved=false
    if [ -n "${ONEKVM_BOOT_ERROR_DIR:-}" ]; then
        if nanokvm_write_boot_error "$ONEKVM_BOOT_ERROR_DIR" "$1"; then
            nanokvm_boot_error_saved=true
        else
            printf 'OneKVM: cannot save boot error in %s\n' "$ONEKVM_BOOT_ERROR_DIR" >&2
        fi
        return 0
    fi
    # Tests and a normal shell must not mount the host disk. Init is pid 1.
    [ "$$" -eq 1 ] || return 0
    if nanokvm_boot_error_open; then
        if nanokvm_write_boot_error "$boot_error_mount" "$1"; then
            nanokvm_boot_error_saved=true
        else
            printf 'OneKVM: cannot save boot error in %s\n' "$boot_error_mount" >&2
        fi
    else
        printf 'OneKVM: cannot open boot partition for error record\n' >&2
    fi
    nanokvm_boot_error_close || true
    return 0
}

nanokvm_read_splash_language() {
    # firstboot.txt contains credentials and CLI statements, never shell code.
    # Read only the installer's canonical language statement, without eval/source.
    splash_language=en
    language_mount=$migration_dir/language
    mkdir -p "$language_mount" || return 0
    if mount -t vfat -o ro,nodev,nosuid,noexec "$loader" "$language_mount"; then
        if [ -f "$language_mount/firstboot.txt" ]; then
            splash_language=$(awk '
                $1 == "set" && $2 == "system" && $3 == "language" && NF == 4 {
                    if ($4 == "en" || $4 == "zh" || $4 == "zh_tw") value=$4
                }
                END { print value == "" ? "en" : value }
            ' "$language_mount/firstboot.txt")
        fi
        umount "$language_mount" || nanokvm_die "cannot release language inspection mount"
    fi
    rmdir "$language_mount" 2>/dev/null || true
    nanokvm_splash boot
}

nanokvm_start_splash() {
    # The Pro Desk panel must be ready before installing or expanding /boot.
    # Other boards have no splash binary or no matching framebuffer. Loading
    # and drawing are best effort and must never hold up storage recovery.
    command -v onekvm-boot-splash >/dev/null 2>&1 || return 0
    if [ ! -e /dev/fb0 ]; then
        insmod /usr/lib/onekvm-initramfs/fbtft.ko 2>/dev/null || true
        insmod /usr/lib/onekvm-initramfs/fb_jd9853.ko 2>/dev/null || true
    fi
    nanokvm_splash boot
}

nanokvm_wait_for_block() {
    path=$1
    count=0
    while [ ! -b "$path" ] && [ "$count" -lt 100 ]; do
        sleep 0.1
        count=$((count + 1))
    done
    [ -b "$path" ]
}

nanokvm_partition_matches() {
    number=$1
    expected_start=$2
    expected_size=$3
    sys_partition="/sys/class/block/${disk_name}p${number}"

    [ -e "$sys_partition/start" ] && [ -e "$sys_partition/size" ] ||
        return 1
    read -r actual_start <"$sys_partition/start"
    read -r actual_size <"$sys_partition/size"
    [ "$actual_start" -eq "$expected_start" ] &&
        [ "$actual_size" -eq "$expected_size" ]
}

nanokvm_partition_starts_at() {
    number=$1
    expected_start=$2
    sys_partition="/sys/class/block/${disk_name}p${number}"

    [ -e "$sys_partition/start" ] || return 1
    read -r actual_start <"$sys_partition/start"
    [ "$actual_start" -eq "$expected_start" ]
}

nanokvm_partition_size() {
    number=$1
    sys_partition="/sys/class/block/${disk_name}p${number}"

    [ -e "$sys_partition/size" ] || return 1
    read -r actual_size <"$sys_partition/size"
    printf '%s\n' "$actual_size"
}

nanokvm_filesystem_type() {
    blkid -p -s TYPE -o value "$1" 2>/dev/null || true
}

nanokvm_oled_module=/usr/lib/onekvm-initramfs/onekvm-installing-oled.ko
nanokvm_oled_param=/sys/module/onekvm_installing_oled/parameters/state

nanokvm_oled_state() {
    [ "${oled_loaded:-false}" = true ] || return 0
    printf '%s %s\n' "$1" "$2" >"$nanokvm_oled_param" 2>/dev/null ||
        info "OneKVM: could not update the Installing OLED"
}

nanokvm_start_oled() {
    oled_loaded=false
    [ "$storage_media" = nanokvm ] || return 0
    if insmod "$nanokvm_oled_module" mode=install step="${nanokvm_oled_step:-0}" 2>/dev/null; then
        oled_loaded=true
        msg "OneKVM: Install OS OLED screen enabled"
    else
        info "OneKVM: Installing OLED is not available on this board"
    fi
}

# Show where setup stopped. The module exists only in NanoKVM initramfs, so
# this also covers failures before the boot medium is identified.
nanokvm_oled_error() {
    if [ "${oled_loaded:-false}" = true ]; then
        nanokvm_oled_state error "${nanokvm_oled_step:-0}"
        return 0
    fi
    [ -f "$nanokvm_oled_module" ] || return 0
    case "${storage_media:-nanokvm}" in nanokvm) ;; *) return 0 ;; esac
    insmod "$nanokvm_oled_module" mode=error step="${nanokvm_oled_step:-0}" 2>/dev/null &&
        oled_loaded=true
}

nanokvm_stop_oled() {
    if [ "$oled_loaded" = true ]; then
        rmmod onekvm_installing_oled ||
            msg "OneKVM: warning: could not release Installing OLED module"
        oled_loaded=false
    fi
}

# Read COUNT little-endian 16-bit words at byte OFFSET of DEVICE into
# root_words, lowest word first.
nanokvm_read_words() {
    set -- $(dd if="$1" bs=1 skip="$2" count=$(($3 * 2)) 2>/dev/null |
        od -d | sed -n '1p')
    shift
    case "$*" in
        ''|*[!0-9\ ]*) nanokvm_die "could not read the rootfs A image header" ;;
    esac
    root_words=$*
}

# Bytes used by the read-only root image in DEVICE of TYPE. Images stay below
# 4 GiB. SquashFS: bytes_used, le64 at offset 40. EROFS: blocks_lo (le32 at
# superblock + 36) << blkszbits (u8 at superblock + 12), superblock at 1024;
# 48-bit block counts are rejected.
nanokvm_root_bytes() {
    case "$2" in
        squashfs)
            nanokvm_read_words "$1" 40 4
            set -- $root_words
            [ "$#" -eq 4 ] && [ "$3" -eq 0 ] && [ "$4" -eq 0 ] ||
                nanokvm_die "rootfs A SquashFS size is invalid"
            rootfs_bytes_used=$(($1 + $2 * 65536))
            ;;
        erofs)
            nanokvm_read_words "$1" 1024 2
            [ "$root_words" = "57826 57589" ] ||
                nanokvm_die "rootfs A EROFS superblock is missing"
            nanokvm_read_words "$1" 1036 1
            root_blkszbits=$((root_words % 256))
            nanokvm_read_words "$1" 1104 1
            [ $((root_words & 128)) -eq 0 ] ||
                nanokvm_die "rootfs A EROFS uses 48-bit block counts"
            nanokvm_read_words "$1" 1060 2
            set -- $root_words
            [ "$#" -eq 2 ] && [ "$root_blkszbits" -ge 9 ] && [ "$root_blkszbits" -le 16 ] ||
                nanokvm_die "rootfs A EROFS size is invalid"
            [ "$2" -lt $((1 << (16 - root_blkszbits))) ] ||
                nanokvm_die "rootfs A EROFS size exceeds 4 GiB"
            rootfs_bytes_used=$((($1 + $2 * 65536) << root_blkszbits))
            ;;
        *) nanokvm_die "rootfs A is neither SquashFS nor EROFS" ;;
    esac
}

nanokvm_copy_root_to_ram() {
    mkdir -p "$migration_dir"
    nanokvm_root_bytes "$root_a" "$root_a_type"
    [ "$rootfs_bytes_used" -ge 4096 ] &&
        [ "$rootfs_bytes_used" -le "$root_source_bytes" ] &&
        [ "$rootfs_bytes_used" -le "$root_slot_bytes" ] ||
        nanokvm_die "rootfs A image size is outside the source partition"
    root_copy_blocks=$(((rootfs_bytes_used + 1048575) / 1048576))
    root_copy_bytes=$((root_copy_blocks * 1048576))
    # The installer carrier partition is exactly the image file size, so its
    # final 1 MiB read is normally a short record. Installed A/B slots are
    # larger and still copy a complete final block. Both cases are complete as
    # long as every byte available up to the rounded image length was read.
    if [ "$root_source_bytes" -lt "$root_copy_bytes" ]; then
        root_copy_bytes=$root_source_bytes
    fi

    mem_available_kib=0
    while read -r key value unit; do
        case "$key" in
            MemAvailable:) mem_available_kib=$value; break ;;
        esac
    done </proc/meminfo
    required_mem_kib=$(((root_copy_bytes + 1023) / 1024 + 16384))
    [ "$mem_available_kib" -ge "$required_mem_kib" ] ||
        nanokvm_die "not enough RAM is available for the protected rootfs copy"

    # /run defaults to half of RAM. The combined boot/root backup can be
    # larger, so give it a separate tmpfs bounded by available RAM minus the
    # same reserve. No file contents are allocated until the copies below.
    migration_ram_kib=$((mem_available_kib - 16384))
    mount -t tmpfs -o "mode=0700,size=${migration_ram_kib}k" tmpfs "$migration_dir" ||
        nanokvm_die "cannot prepare protected migration RAM"
    msg "OneKVM: copying NanoKVM rootfs A into RAM"
    dd if="$root_a" of="$root_image" bs=1048576 count="$root_copy_blocks" ||
        nanokvm_die "could not copy rootfs A into RAM"
    image_bytes=$(wc -c <"$root_image")
    [ "$image_bytes" -eq "$root_copy_bytes" ] ||
        nanokvm_die "rootfs A RAM copy is incomplete"
}

# Both slots are copies of rootfs A, so they carry its filesystem type.
nanokvm_verify_root() {
    device=$1
    name=$2
    verify_mount="$migration_dir/verify-$name"
    mkdir -p "$verify_mount"
    mount -t "$root_a_type" -o ro "$device" "$verify_mount" ||
        nanokvm_die "rootfs $name is not a mountable $root_a_type root"
    umount "$verify_mount" ||
        nanokvm_die "could not unmount verified rootfs $name"
    rmdir "$verify_mount"
}

nanokvm_inspect_carrier() {
    grow_boot=false
    source_loader_size=$loader_size
    source_root_start=$root_a_start
    onekvm_storage_carrier_geometry || return 0
    boot_mount=$migration_dir/boot-mount
    boot_backup=$migration_dir/boot-files
    mkdir -p "$boot_mount" || nanokvm_die "cannot create boot inspection directory"
    mount -t vfat -o ro,nodev,nosuid,noexec "$loader" "$boot_mount" ||
        nanokvm_die "cannot inspect carrier boot filesystem"
    if [ -f "$boot_mount/bootgrow" ]; then
        [ "$(cat "$boot_mount/bootgrow")" = 128 ] || nanokvm_die "unsupported installed boot size"
        expected_id=0x4f4b564d
        [ "$storage_media" = nanokvm ] || expected_id=0x4f4b5650
        [ "$(sfdisk --disk-id "$disk")" = "$expected_id" ] || nanokvm_die "unexpected carrier disk identifier"
        grow_boot=true
        source_loader_size=$carrier_boot_size
        source_root_start=$carrier_root_start
        loader_size=262144
        root_a_start=264192
        root_b_start=$((root_a_start + root_slot_size + root_b_gap))
        userdata_start=$((root_b_start + root_slot_size))
    fi
    umount "$boot_mount" || nanokvm_die "cannot release carrier boot filesystem"
}

nanokvm_copy_boot_to_ram() {
    [ "$grow_boot" = true ] || return 0
    mkdir -p "$boot_mount" || nanokvm_die "cannot create boot copy mountpoint"
    mount -t vfat -o ro,nodev,nosuid,noexec "$loader" "$boot_mount" ||
        nanokvm_die "cannot read carrier boot files"
    set -- $(du -sk "$boot_mount")
    boot_kib=$1
    mem_available_kib=$(sed -n 's/^MemAvailable:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)
    [ "$mem_available_kib" -ge "$((boot_kib + 16384))" ] ||
        nanokvm_die "not enough RAM for the protected boot file copy"
    msg "OneKVM: preserving boot files and firstboot configuration in RAM"
    (cd "$boot_mount" && find . -type f -exec sha256sum '{}' ';') >"$migration_dir/boot.sha256" ||
        nanokvm_die "cannot checksum carrier boot files"
    mkdir -p "$boot_backup" && cp -R "$boot_mount/." "$boot_backup/" ||
        nanokvm_die "cannot copy carrier boot files to RAM"
    (cd "$boot_backup" && sha256sum -c "$migration_dir/boot.sha256") ||
        nanokvm_die "boot RAM copy verification failed"
    nanokvm_expand_compact_nanokvm_boot
    nanokvm_expand_compact_pro_sd_boot
    umount "$boot_mount" || nanokvm_die "cannot release carrier boot filesystem"
}

nanokvm_expand_compact_nanokvm_boot() {
    [ "$storage_media" = nanokvm ] && [ "$grow_boot" = true ] || return 0
    if [ ! -e "$boot_backup/bootclone" ]; then
        [ -s "$boot_backup/boot-b.itb" ] || nanokvm_die "carrier is missing boot-b.itb"
        return 0
    fi
    [ "$(cat "$boot_backup/bootclone")" = A ] || nanokvm_die "unsupported boot clone source"
    [ -s "$boot_backup/boot.sd" ] && [ -s "$boot_backup/build-id-a" ] &&
        [ -s "$boot_backup/build-id-b" ] &&
        cmp -s "$boot_backup/build-id-a" "$boot_backup/build-id-b" ||
        nanokvm_die "compact NanoKVM carrier has missing or mismatched A/B payloads"
    if [ -e "$boot_backup/boot-b.itb" ]; then
        [ -s "$boot_backup/boot-b.itb" ] || nanokvm_die "carrier has an empty boot-b.itb"
        return 0
    fi
    clone_bytes=$(stat -c %s "$boot_backup/boot.sd")
    mem_available_kib=$(sed -n 's/^MemAvailable:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)
    [ "$mem_available_kib" -ge "$(((clone_bytes + 1023) / 1024 + 16384))" ] ||
        nanokvm_die "not enough RAM to initialize boot slot B"
    cp "$boot_backup/boot.sd" "$boot_backup/boot-b.itb" &&
        cmp -s "$boot_backup/boot.sd" "$boot_backup/boot-b.itb" ||
        nanokvm_die "could not initialize boot slot B from A"
    (cd "$boot_backup" && find . -type f -exec sha256sum '{}' ';') >"$migration_dir/boot.sha256" ||
        nanokvm_die "could not checksum initialized NanoKVM boot files"
}

nanokvm_expand_compact_pro_sd_boot() {
    [ "$storage_media" = pro-sd ] || return 0
    [ "$grow_boot" = true ] || return 0
    # The downloadable Pro SD carrier contains only slot A's large payloads.
    # Materialize slot B before the partition table is rebuilt, while both the
    # source files and the protected copy are available. Slot scripts remain
    # separate because their root PARTUUID and loaded filenames differ.
    for pair in \
        'Image-a Image-b' \
        'ax630c-a.dtb ax630c-b.dtb' \
        'initramfs-a.uimg initramfs-b.uimg'; do
        set -- $pair
        [ -f "$boot_backup/$1" ] || nanokvm_die "compact Pro SD carrier is missing $1"
        [ -e "$boot_backup/$2" ] || cp "$boot_backup/$1" "$boot_backup/$2" ||
            nanokvm_die "could not materialize compact Pro SD $2"
    done
    (cd "$boot_backup" && find . -type f -exec sha256sum '{}' ';') >"$migration_dir/boot.sha256" ||
        nanokvm_die "could not checksum expanded Pro SD boot files"
}

nanokvm_restore_boot() {
    [ "$grow_boot" = true ] || return 0
    msg "OneKVM: creating installed 128 MiB boot filesystem"
    mkfs.vfat -F 16 -n ONEKVMBOOT "$loader" || nanokvm_die "cannot format installed boot filesystem"
    mount -t vfat -o rw,nodev,nosuid,noexec "$loader" "$boot_mount" ||
        nanokvm_die "cannot mount installed boot filesystem"
    cp -R "$boot_backup/." "$boot_mount/" || nanokvm_die "cannot restore boot files"
    sync
    (cd "$boot_mount" && sha256sum -c "$migration_dir/boot.sha256") ||
        nanokvm_die "installed boot file verification failed"
    rm -f "$boot_mount/bootgrow" "$boot_mount/bootclone" || nanokvm_die "cannot complete boot expansion"
    sync
    umount "$boot_mount" || nanokvm_die "cannot release installed boot filesystem"
}

nanokvm_refresh_partitions() {
    sync
    blockdev --rereadpt "$disk" 2>/dev/null || true
    partx --update "$disk" 2>/dev/null || true
    nanokvm_wait_for_block "$root_b" ||
        nanokvm_die "rootfs B partition did not appear"
    nanokvm_wait_for_block "$userdata" ||
        nanokvm_die_userdata "userdata partition did not appear"
}

nanokvm_rebuild_partition_table() {
    disk_id=$(sfdisk --disk-id "$disk" 2>/dev/null) ||
        nanokvm_die "could not read the existing DOS disk identifier"
    case "$disk_id" in
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        *) nanokvm_die "invalid DOS disk identifier $disk_id" ;;
    esac

    msg "OneKVM: rebuilding NanoKVM rootfs A/B and userdata partitions"
    sfdisk --no-reread --force "$disk" <<EOF ||
label: dos
label-id: $disk_id
unit: sectors

start=$loader_start, size=$loader_size, type=$loader_type, bootable
start=$root_a_start, size=$root_slot_size, type=83
start=$root_b_start, size=$root_slot_size, type=83
start=$userdata_start, size=$userdata_size, type=83
EOF
        nanokvm_die "could not write the NanoKVM partition table"

    nanokvm_refresh_partitions
    nanokvm_partition_matches 1 "$loader_start" "$loader_size" ||
        nanokvm_die "loader partition changed during migration"
    nanokvm_partition_matches 2 "$root_a_start" "$root_slot_size" ||
        nanokvm_die "rootfs A partition geometry is incorrect"
    nanokvm_partition_matches 3 "$root_b_start" "$root_slot_size" ||
        nanokvm_die "rootfs B partition geometry is incorrect"
    nanokvm_partition_matches 4 "$userdata_start" "$userdata_size" ||
        nanokvm_die_userdata "userdata partition geometry is incorrect"
}

nanokvm_write_root_slots() {
    msg "OneKVM: restoring NanoKVM rootfs B"
    dd if="$root_image" of="$root_b" bs=1048576 count="$root_copy_blocks" ||
        nanokvm_die "could not write rootfs B"
    sync
    nanokvm_verify_root "$root_b" B

    # The compact carrier's A moves after the larger installed boot partition.
    # Restore both slots from the protected copy.
    msg "OneKVM: restoring NanoKVM rootfs A"
    dd if="$root_image" of="$root_a" bs=1048576 count="$root_copy_blocks" ||
        nanokvm_die "could not restore rootfs A"
    sync
    nanokvm_verify_root "$root_a" A
}

nanokvm_make_userdata() {
    msg "OneKVM: creating NanoKVM userdata filesystem"
    # New layouts use f2fs. An existing ext4 or f2fs filesystem is left
    # untouched by the caller; this path only runs when the partition is empty.
    mkfs.f2fs -f -l userdata \
        -U "$userdata_uuid" \
        "$userdata" >/dev/null ||
        nanokvm_die_userdata "could not create the userdata filesystem"

    verify_mount="$migration_dir/verify-userdata"
    mkdir -p "$verify_mount"
    mount -t f2fs -o rw "$userdata" "$verify_mount" ||
        nanokvm_die_userdata "userdata is not a mountable f2fs filesystem"
    sync
    umount "$verify_mount" ||
        nanokvm_die "could not unmount verified userdata"
    rmdir "$verify_mount"
}

nanokvm_extend_userdata() {
    [ "$existing_userdata_size" -lt "$userdata_size" ] || return 0
    [ "$storage_media" != pro-emmc ] || nanokvm_die "eMMC userdata geometry is incomplete"
    printf 'start=%s, size=%s, type=83\n' "$userdata_start" "$userdata_size" |
        sfdisk --no-reread --force -N 4 "$disk" || nanokvm_die "cannot grow userdata partition"
    nanokvm_refresh_partitions
    case "$userdata_type" in
        ext4)
            check=0; e2fsck -pf "$userdata" || check=$?
            [ "$check" -le 1 ] || nanokvm_die "userdata filesystem check failed"
            resize2fs -f "$userdata" || nanokvm_die "cannot grow ext4 userdata" ;;
        f2fs) resize.f2fs "$userdata" || nanokvm_die "cannot grow f2fs userdata" ;;
    esac
}

nanokvm_migrate_overlay() {
    [ "$storage_media" != nanokvm ] || return 0
    legacy_mount=/run/onekvm-legacy-data
    mkdir -p "$legacy_mount"
    mount -t "$userdata_type" -o rw "$userdata" "$legacy_mount" || nanokvm_die "cannot inspect userdata"
    # Only the previous Pro experimental layout has slots/*/upper and
    # shared-data. Renames make this conversion safe to repeat after power loss.
    legacy_slot=$storage_slot
    if [ -f "$legacy_mount/storage/.legacy-active-slot" ]; then
        read -r legacy_slot <"$legacy_mount/storage/.legacy-active-slot"
        case "$legacy_slot" in A|B) ;; *) nanokvm_die "invalid legacy slot marker" ;; esac
    fi
    if [ ! -d "$legacy_mount/upper" ] && [ -d "$legacy_mount/slots/$legacy_slot/upper" ]; then
        mv "$legacy_mount/slots/$legacy_slot/upper" "$legacy_mount/upper" || nanokvm_die "cannot migrate upper"
    fi
    if [ -d "$legacy_mount/shared-data" ]; then
        mkdir -p "$legacy_mount/upper"
        if [ -d "$legacy_mount/upper/data" ]; then
            rmdir "$legacy_mount/upper/data" || nanokvm_die "unexpected data in legacy upper"
        fi
        mv "$legacy_mount/shared-data" "$legacy_mount/upper/data" || nanokvm_die "cannot migrate shared data"
    fi
    rm -f "$legacy_mount/storage/.legacy-active-slot"
    sync
    umount "$legacy_mount" || nanokvm_die "cannot release userdata"
    rmdir "$legacy_mount"
}

nanokvm_run() {
    nanokvm_start_splash
    . /usr/lib/onekvm/storage-layout.sh
    onekvm_storage_select || nanokvm_die "cannot identify boot medium"
    loader_type=c
    [ "$storage_media" = nanokvm ] || loader_type=e
    migration_dir=/run/onekvm-firstboot
    root_image=$migration_dir/rootfs-a.img
    oled_loaded=false

    nanokvm_wait_for_block "$disk" || nanokvm_die "SD card was not found"
    nanokvm_wait_for_block "$loader" ||
        nanokvm_die "loader partition was not found"
    nanokvm_wait_for_block "$root_a" ||
        nanokvm_die "rootfs A partition was not found"

    storage_kind=$(cat "/sys/class/block/$disk_name/device/type") ||
        nanokvm_die "cannot identify storage hardware"
    case "$storage_media:$storage_kind" in
        nanokvm:SD|pro-sd:SD|pro-emmc:MMC) ;;
        *) nanokvm_die "boot parameters disagree with storage hardware" ;;
    esac

    # Do not write an unrecognized layout. Carrier geometry is sufficient
    # for FAT repair; its bootgrow marker is still required for migration.
    if onekvm_storage_validate 2>/dev/null || onekvm_storage_carrier_geometry; then
        . /usr/lib/onekvm/boot-fat.sh
        onekvm_boot_fat_check
    fi
    nanokvm_read_splash_language
    nanokvm_inspect_carrier
    read -r disk_size <"/sys/class/block/$disk_name/size"
    userdata_size=$((disk_size - userdata_start))
    [ "$userdata_size" -ge 65536 ] ||
        nanokvm_die "SD card is too small for a safe userdata filesystem"

    # Destructive migration is allowed only from the OneKVM loader geometry,
    # the expected rootfs start sector, and a positively identified read-only
    # root. The downloadable image deliberately sizes its sole rootfs partition
    # to the image file; only the installed A/B layout uses 128 MiB slots.
    nanokvm_partition_matches 1 "$loader_start" "$source_loader_size" ||
        nanokvm_die "unknown loader partition geometry; refusing migration"
    nanokvm_partition_starts_at 2 "$source_root_start" ||
        nanokvm_die "unknown rootfs A start sector; refusing migration"

    p3_present=false
    p4_present=false
    [ ! -e "/sys/class/block/${disk_name}p3" ] || p3_present=true
    [ ! -e "/sys/class/block/${disk_name}p4" ] || p4_present=true

    root_source_size=$(nanokvm_partition_size 2) ||
        nanokvm_die "could not read the rootfs A partition size"
    [ "$root_source_size" -gt 0 ] &&
        [ "$root_source_size" -le "$root_slot_size" ] ||
        nanokvm_die "rootfs A partition exceeds the installed slot size"
    root_source_bytes=$((root_source_size * 512))

    if [ "$p3_present" = true ]; then
        [ "$root_source_size" -eq "$root_slot_size" ] ||
            nanokvm_die "rootfs A is not an installed 128 MiB slot"
        nanokvm_partition_matches 3 "$root_b_start" "$root_slot_size" ||
            nanokvm_die "unknown rootfs B geometry; refusing migration"
    fi
    if [ "$p4_present" = true ]; then
        [ "$p3_present" = true ] ||
            nanokvm_die "userdata exists without rootfs B; refusing migration"
        nanokvm_partition_starts_at 4 "$userdata_start" ||
            nanokvm_die "unknown userdata start; refusing migration"
        existing_userdata_size=$(nanokvm_partition_size 4)
        [ "$existing_userdata_size" -ge 65536 ] && [ "$existing_userdata_size" -le "$userdata_size" ] ||
            nanokvm_die "unknown userdata size; refusing migration"
        userdata_type=$(nanokvm_filesystem_type "$userdata")
        if [ "$userdata_type" = ext4 ] || [ "$userdata_type" = f2fs ]; then
            # An initialized layout must reach Recovery even when a root
            # slot is damaged. Repair is performed by the signed installer.
            nanokvm_extend_userdata
            nanokvm_migrate_overlay
            info "OneKVM: A/B storage layout is complete"
            return 0
        fi
        [ -z "$userdata_type" ] ||
            nanokvm_die "userdata contains $userdata_type; refusing destructive migration"
    fi

    root_a_type=$(nanokvm_filesystem_type "$root_a")
    case "$root_a_type" in
        squashfs|erofs) ;;
        *) nanokvm_die "rootfs A is neither SquashFS nor EROFS; refusing initialization" ;;
    esac
    if [ "$storage_media" = pro-emmc ]; then
        # Linux cmdline partitions preserve the entire vendor boot prefix.
        # Never write an MBR or a partition table to this medium.
        onekvm_storage_validate || nanokvm_die "invalid eMMC cmdline partitions"
        [ "$storage_slot" = A ] || nanokvm_die "initialize eMMC from slot A"
        nanokvm_splash install 1
        nanokvm_copy_root_to_ram
        nanokvm_splash install 5
        dd if="$root_image" of="$root_b" bs=1048576 count="$root_copy_blocks" || nanokvm_die "cannot initialize eMMC rootfs B"
        sync
        nanokvm_verify_root "$root_b" B
        nanokvm_splash install 6
        nanokvm_make_userdata
        nanokvm_splash install 7
        rm -f "$root_image"
        umount "$migration_dir" || nanokvm_die "cannot release migration RAM"
        rmdir "$migration_dir" 2>/dev/null || true
        nanokvm_splash boot
        return 0
    fi
    [ "$storage_slot" != B ] || nanokvm_die "cannot initialize storage from slot B"
    nanokvm_start_oled
    nanokvm_splash install 1
    nanokvm_copy_root_to_ram
    nanokvm_splash install 2
    nanokvm_copy_boot_to_ram
    nanokvm_splash install 3
    nanokvm_rebuild_partition_table
    nanokvm_splash install 4
    nanokvm_restore_boot
    nanokvm_splash install 5
    nanokvm_write_root_slots
    nanokvm_splash install 6
    nanokvm_make_userdata
    nanokvm_splash install 7
    sync
    nanokvm_stop_oled
    rm -f "$root_image"
    if [ "$grow_boot" = true ]; then
        rm -rf "$boot_backup"
        rm -f "$migration_dir/boot.sha256"
        rmdir "$boot_mount"
    fi
    umount "$migration_dir" || nanokvm_die "cannot release migration RAM"
    rmdir "$migration_dir" 2>/dev/null || true
    msg "OneKVM: NanoKVM A/B storage migration complete"
    nanokvm_splash boot
}
