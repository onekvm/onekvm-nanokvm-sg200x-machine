#!/bin/sh
# Publish the Pro bridge driver's information at the shared shell lookup path.
# Boot never programs the bridge EDID; users change it from the Web settings.
set -eu

model_path=${ONEKVM_EDID_MODEL_PATH:-/proc/device-tree/model}
info=${ONEKVM_LT6911_PROC:-/proc/lt6911_info}
run_dir=${ONEKVM_RUN_DIR:-/run/onekvm}

model=$(tr -d '\000' <"$model_path")
case "$model" in
    *NanoKVM*Pro*) ;;
    *) echo "Pro capture chip: another machine; skip"; exit 0 ;;
esac
if [ ! -d "$info" ]; then
    echo "Pro capture chip: driver information unavailable" >&2
    exit 0
fi
mkdir -p "$run_dir"
if [ ! -e "$run_dir/lt6911_info" ] && [ ! -L "$run_dir/lt6911_info" ]; then
    ln -s "$info" "$run_dir/lt6911_info"
fi
echo "Pro capture chip: $(tr -d '\r\n' <"$info/chip_id" 2>/dev/null || echo unknown)"
