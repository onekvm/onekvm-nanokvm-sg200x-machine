[Unit]
Description=Initialize OneKVM capture chip
After=local-fs.target onekvm-persistence.service onekvm-machine-nanokvm-detect.service
Before=onekvm-video-soph-mmf-modules.service onekvm.service

[Service]
Type=oneshot
TimeoutStartSec=180
# Package installation may request a service restart during an active stream.
# Defer chip access until Core next starts with the capture bus released.
# A later transaction (for example D-Bus activation of a unit bound to Core)
# re-queues this unit after a failure; Core is then still "activating".
ExecCondition=/bin/sh -c 'case "$(systemctl is-active onekvm.service)" in inactive|failed) exit 0 ;; *) exit 1 ;; esac'
ExecStart=/usr/libexec/onekvm/onekvm-capture-chip-init
RemainAfterExit=yes

[Install]
WantedBy=onekvm.service
